 "poems": [
  {
   "seq": "1",
   "text": "花の色はうつりにけりな徒に我身世にふるなかめせしまに",
   "kana": "",
   "speaker": "",
   "page": 78,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "心からうきたる舟に乘りそめてひとひも浪にぬれぬ日そなき",
   "kana": "",
   "speaker": "",
   "page": 78,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "空を行月の光を雲井よりみてやゝみにて世ははてぬへき",
   "kana": "",
   "speaker": "",
   "page": 78,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "雲はれて思ひ出れとことのはのちれるなけきは思ひ出もなき",
   "kana": "",
   "speaker": "",
   "page": 78,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "みるめかる蜑の行かふ湊路になこその關も我はすへぬを",
   "kana": "",
   "speaker": "",
   "page": 78,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "なにしおへは猶なつかしみ女郞花おられに鳬な我か名たてに",
   "kana": "",
   "speaker": "",
   "page": 78,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "やよやまて山ほとゝきすことつてむ我世中に住わひぬとよ",
   "kana": "",
   "speaker": "",
   "page": 78,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "結ひきといひける物を結ひ松いかてか君にとけてみゆへき",
   "kana": "",
   "speaker": "",
   "page": 78,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "よそにこそみねの白雲と思ひしにふたりか中にはや立にけり",
   "kana": "",
   "speaker": "",
   "page": 78,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "山さとのあれたる宿をてらしつゝ幾夜へぬらん秋の月影",
   "kana": "",
   "speaker": "小町集",
   "page": 78,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "秋の月いかなる物そわか心なにともなきにいれかてにする",
   "kana": "",
   "speaker": "",
   "page": 78,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "秋の夜も名のみなりけりあいとあへは〓とそ共なく明ぬる物を",
   "kana": "",
   "speaker": "",
   "page": 78,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "長しとも思ひそ果ぬ昔よりあふ人からの秋のよなれは",
   "kana": "",
   "speaker": "",
   "page": 78,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "現にはさもこそあらめ夢にさへ人めつゝむとみるか侘しき",
   "kana": "",
   "speaker": "",
   "page": 78,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "あまの住里のゑるへもあらなくに恨みむとのみ人のいふらん",
   "kana": "",
   "speaker": "",
   "page": 78,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "思ひつゝぬれはや人のみえつ覽夢としりせはさめさらましを",
   "kana": "",
   "speaker": "",
   "page": 78,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "うたゝねに戀しき人をみてしより夢てふ物は賴み初てき",
   "kana": "",
   "speaker": "",
   "page": 78,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "たのましと思はむとてもいかゝせん夢より外に逢よなけれは",
   "kana": "",
   "speaker": "小町集",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "いとせめて戀しき時はうは玉の夜の衣をかへしてそぬる",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "色みえてうつろふ物は世中の人の心の花にそ有ける",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "秋風にあふ賴こそかなしけれ我身むなしくなりぬと思へは",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "和田つ海のみるめは誰かかりはてし世の人〓にになしといはすは",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "みるめなき我身をうらと知られはやかれなて蜑の足たゆくゝる",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "人にあはむ月のなきよに思ひ置てむねはしりひに心やけおり",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "夢路にはあしもやすめすかまへ共現にひとめみし〓とはあらす",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "かさまゝつあましか津かはあふ事のたよりに浪は海と成らん",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "われを君思ふ心のけすのへにありけはまさに逢みてましを",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "よそにてもみすは有とも人心わすれかたみをつみて忍はむ",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "宵〓〓の夢の玉しゐあしたゆくありても待んとふらひにこそ",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "おきの井てみをやくよりもかなしきは都ふまへの別也けり",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "今はとて我身ゑくれと降ぬれは〓との葉さへにうつろひにけり",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "人を思ふ心この葉にあらはこそ風のまに〓〓散もまかはめ",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "蜑のすむうらこく舟のかちをなみ世をうみ渡る我そかなしき",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "いはのうへに旅ねをすれはいと寒し苔の衣を我にかさなん",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "世をそむく苔の衣は只ひとへかさねはうとしいさふたりねん",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "ひとりねの侘しきまゝに起ゐつゝ月を哀といみそかねつる",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "みちのくの玉つくり江にこく舟のほにこそ出ね君を戀れと",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "侘ぬれは身を浮草のねを絕て誘ふ水あらはいなんとそ思ふ",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "つゝめとも袖にたまらぬふら玉は人をみぬめの泪なりけり",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "をろかなる淚そ袖に玉はなす我はせきあへす瀧つせなれは",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "みるめあらは恨みむやはとあま問はゝ浮ひて待んうたかたのまも",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "いつはとは時はわかねと秋のよそ物思ふ事のかきりなりける",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "蜩のなく山里の夕くれは風よりほかにとふ人そなき",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "もゝ草の花のひもとく秋のゝに思ひたはれむ人なとかめそ",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "こきゝぬや蜑のかせまもまたすしてにくさひかける蜑の釣舟",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "あやめ草人にねたゆと思ひしは我身のうきにおふるなりけり",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "こぬ人をまつとなかめて我宿のなとてこのくれ悲しかるらむ",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "露の命はかなき物を朝夕にいきたる限あひみてしかな",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "人ゑれぬ我か思ひにあはぬ夜はみさへぬるみておもほゆる哉",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "戀侘ぬふはしもねばや夢のうちにみゆれは逢ぬみねは忘れぬ",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "ものなこそ岩ねの松も思らめ千代ふる末もかたふにけり",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "木枯の風にもちらて人ゑれすうき〓とのはのつもるころかな",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "夏のよの侘しき〓とは夢にさへみる音もなく明る也けり",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "うつゝにもあるたに有をゆめにさへあかても人のみえ渡る哉",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "春雨のさはにふる〓とをともなく人にふられてぬるゝ袖かな",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "今朝よりは悲しき宮の秋かせや又あふ〓ともあらしとおもへは",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "われか身にきにける物をうきとは人のうへとも思ひける哉",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "心にもかなはさりける世中をうき身はみしとおもひけるかな",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "つま戀るさを鹿の音にさよふけて我かたこひを明しかねぬる",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "卯花のさける垣ねにときならてわかとそ鳴うくひすのこゑ",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "秋の田の假庵にきゆるいなかたのいなとも人にいはまし物を",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "色も香もなつかしきかな蛙なくゐてのわたりの山ふきの花",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "霞たつ野をなつかしみ春駒のあれても君かみえ渡る哉",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "難波めの釣する人にめかれけむ人もわか〓と袖やぬるらん",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "千度ともふられさりけりうたかたのうきみはいさや物忘して",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "いまはとて變らぬ物をいにしへもかく社君につれなかりしか",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "浪の面をいて入鳥は水底をおほつかなくは思はさらなん",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "あしたつの雲井のなかにましりなは〔已下關〕",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "千早振神もみまさは立さはき天のとかはのひくちあけたまへ",
   "kana": "",
   "speaker": "このよには思ふ〓となき",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "瀧の水木本ちかくなかれすはうたかた花もありとみましや",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "かきりなき思ひのまゝに夜もこむ夢ちをさへに人はとかめし",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "時過てかれ行をのゝ淺茅には今は思ひそたえすもえける",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "うきとを忍ふるあめのしたにふく我ぬれ衣はほせとかはかす",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "ともすれはあたなる風にさゝ波の靡くてふ〓とわれなひけとや",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "忘草わか身につまむと思ひしは人の心におふるなりけり",
   "kana": "",
   "speaker": "",
   "page": 79,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "わかことく物思ふ心けのすゑに有せはまさにあひみてましを",
   "kana": "",
   "speaker": "小町集",
   "page": 80,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "陸奥は世を浮島もありといふ關こゆるきのいそかさらなん",
   "kana": "",
   "speaker": "",
   "page": 80,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "すまの浦の浦こく舟の梶よりもよるへなきみそ悲しかりける",
   "kana": "",
   "speaker": "",
   "page": 80,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "ひとりねの時は待れし鳥のねのまれにあふ夜は侘しかりけり",
   "kana": "",
   "speaker": "",
   "page": 80,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "なかれてとたのめし〓は行末の涙のうへをいふにそ有ける",
   "kana": "",
   "speaker": "",
   "page": 80,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "有はなくなきはかすそふ世中に哀いつれの日まて歎かむ",
   "kana": "",
   "speaker": "",
   "page": 80,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "夢ならはまたみるよひも有なましなに中〓〓の現なりけん",
   "kana": "",
   "speaker": "",
   "page": 80,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "むさしのに生とし聞は紫のその色ならぬ草もむつまし",
   "kana": "",
   "speaker": "",
   "page": 80,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "世中は飛鳥川にもならはなれ君と我とか中したえすは",
   "kana": "",
   "speaker": "",
   "page": 80,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "むさしのゝ向の岡の草なれは根をたつねても哀とそ思ふ",
   "kana": "",
   "speaker": "",
   "page": 80,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "みし人もふられさり鳬うたかたのうき身はいさや物忘れして",
   "kana": "",
   "speaker": "",
   "page": 80,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "世中にいつら我身のありてなし哀とやいはんあなうとやいはん",
   "kana": "",
   "speaker": "",
   "page": 80,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "我身社あらぬかとのみたとらるれとふへき人に忘られしより",
   "kana": "",
   "speaker": "",
   "page": 80,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "なからへは人の心もみるへきに露の命そがなしかりける",
   "kana": "",
   "speaker": "",
   "page": 80,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "よの中をいとひてあまの住かたはうきめのみ社みえ渡りけれ",
   "kana": "",
   "speaker": "",
   "page": 80,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "はかなくて雲と成ぬる物ならはかすまむ空を哀とは見よ",
   "kana": "",
   "speaker": "",
   "page": 80,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "吾のみや世を鶯と鳴わひむ人の心の花とちりなは",
   "kana": "",
   "speaker": "",
   "page": 80,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "はかなくも枕さためすあかすかな夢かたりせし人をまつとて",
   "kana": "",
   "speaker": "",
   "page": 80,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "世の中のうきもつらきもつけなくにまつある物は泪なりけり",
   "kana": "",
   "speaker": "",
   "page": 80,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "吹むすふかせはむかしの秋なから有しにもあらぬ袖の露哉",
   "kana": "",
   "speaker": "",
   "page": 80,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "あやしくもなくさめかたき心かなをは捨山の月もみなくに",
   "kana": "",
   "speaker": "",
   "page": 80,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "97",
   "text": "ゑとけなきねくたれ髪をみせしとてはた隱れたるけさの朝顔",
   "kana": "",
   "speaker": "",
   "page": 80,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "98",
   "text": "誰をかもまつちの山のをみなへし秋と契れる人そ有らし",
   "kana": "",
   "speaker": "",
   "page": 80,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "99",
   "text": "白雲の絕すたな引峯にたに住はすみぬる物にそありける",
   "kana": "",
   "speaker": "",
   "page": 80,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "100",
   "text": "もみちせぬ常盤の山は吹風の音にや秋を聞わたるらん",
   "kana": "",
   "speaker": "",
   "page": 80,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "101",
   "text": "いつとても戀しからすはあらねともあやしかりける秋の夕暮",
   "kana": "",
   "speaker": "",
   "page": 80,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "102",
   "text": "長月の有明の月の有つゝも君しきまさは待もこそせめ",
   "kana": "",
   "speaker": "",
   "page": 80,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "103",
   "text": "あさか山影さへみゆる山の井の淺くは人をおもふものかは",
   "kana": "",
   "speaker": "",
   "page": 80,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "104",
   "text": "なかめつゝ過る月日もふらぬまに秋のけしきになりにける哉",
   "kana": "",
   "speaker": "",
   "page": 80,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "105",
   "text": "春の日の浦〓〓とを出てみよなにわさしてか蜑は過すと",
   "kana": "",
   "speaker": "",
   "page": 80,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "106",
   "text": "木のまよりもりくる月の影みれは心盡しの秋はきにけり",
   "kana": "",
   "speaker": "",
   "page": 80,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "107",
   "text": "天つかせ雲ふきはらへ久堅の月のかくるゝ道まとはなむ",
   "kana": "",
   "speaker": "",
   "page": 80,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "108",
   "text": "あはれてふ事こそうたて世中を思へはなれぬほたしえけれ",
   "kana": "",
   "speaker": "",
   "page": 80,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "109",
   "text": "世中は夢かうつゝかうつゝとも夢ともふらす有てなけれは",
   "kana": "",
   "speaker": "",
   "page": 80,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "110",
   "text": "あはれてふ〓とのは每にをく露はむかしを戀るなみたなりけり",
   "kana": "",
   "speaker": "",
   "page": 80,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "111",
   "text": "山里は物のさひしき事こそあれ世のうきよりは住よかりけれ",
   "kana": "",
   "speaker": "",
   "page": 80,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "112",
   "text": "小倉山きえしともしの末もかなゑかならはすはやすくねなまし",
   "kana": "",
   "speaker": "",
   "page": 80,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "113",
   "text": "別つゝみるへき人もゑらぬまに秋の氣色になりにける哉",
   "kana": "",
   "speaker": "",
   "page": 80,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "114",
   "text": "かたみこそ今はあたなれこれなくは忘るゝ時もあらまし物を",
   "kana": "",
   "speaker": "",
   "page": 80,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "115",
   "text": "はかなしや我身のはてよ淺みとり野へにたな引霞と思へは",
   "kana": "",
   "speaker": "",
   "page": 80,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "116",
   "text": "花咲てみならぬ物はわたつ海のかさしにさせる沖つふら浪",
   "kana": "",
   "speaker": "",
   "page": 80,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  }
 ],
